  },
  "dependencies": {
    "@kwasu-portal/types": "workspace:*",
    "@kwasu-portal/utils-others": "workspace:*",
    "@kwasu-portal/validators": "workspace:*",
    "@radix-ui/react-slider": "^1.3.6",
